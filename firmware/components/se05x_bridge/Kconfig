menu "Lab bench: SE05x bridge (I2C target <-> SE050Sim over TCP)"

    config LAB_SE05X_BRIDGE
        bool "Stand in for an NXP SE05x on I2C, relaying to the simulator over Wi-Fi"
        default y
        help
            I2C target at the SE05x address; each T=1 frame is relayed to SE050Sim over TCP.
            Needs config.local.h (Wi-Fi and simulator address). The simulator keeps keys in
            clear behind an unauthenticated socket: trusted lab network only.

    config LAB_SE05X_I2C_SDA
        int "I2C SDA GPIO"
        depends on LAB_SE05X_BRIDGE
        range 0 48
        default 8

    config LAB_SE05X_I2C_SCL
        int "I2C SCL GPIO"
        depends on LAB_SE05X_BRIDGE
        range 0 48
        default 9

    config LAB_SE05X_I2C_ADDR
        hex "I2C target address (7 bits)"
        depends on LAB_SE05X_BRIDGE
        range 0x08 0x77
        default 0x48

    config LAB_SE05X_FILL_AFTER_HEADER
        bool "Insert a filler byte after NAD+PCB (ESP32-S3 drops one byte after a 2-byte read)"
        depends on LAB_SE05X_BRIDGE
        default y

endmenu
